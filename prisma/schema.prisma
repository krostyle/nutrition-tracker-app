// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FoodSource {
  OFF
  USDA
  MANUAL
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model Food {
  id         String     @id @default(cuid())
  name       String
  source     FoodSource
  externalId String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Nutrientes por 100g (kcal para calories, gramos, salvo sodium en mg)
  calories     Float
  protein      Float
  carbs        Float
  fat          Float
  fiber        Float?
  sugar        Float?
  saturatedFat Float?
  sodium       Float?

  // Porción recomendada declarada por la fuente (OFF/USDA), cuando existe.
  servingSize  Float?
  servingLabel String?

  logEntries        FoodLogEntry[]
  recipeIngredients RecipeIngredient[]

  @@unique([source, externalId])
}

// Metas vigentes, single-user: una única fila con id fijo "singleton".
model Goal {
  id        String   @id
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  updatedAt DateTime @updatedAt
}

model FoodLogEntry {
  id        String   @id @default(cuid())
  foodId    String
  food      Food     @relation(fields: [foodId], references: [id])
  grams     Float
  mealType  MealType
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model Recipe {
  id        String   @id @default(cuid())
  name      String
  servings  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients RecipeIngredient[]
}

model RecipeIngredient {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  foodId   String
  food     Food   @relation(fields: [foodId], references: [id])
  grams    Float
}
