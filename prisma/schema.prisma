generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FoodSource {
  OFF
  USDA
  MANUAL
}

model Food {
  id         String     @id @default(cuid())
  name       String
  source     FoodSource
  externalId String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Nutrientes por 100g (kcal para calories, gramos, salvo sodium en mg)
  calories     Float
  protein      Float
  carbs        Float
  fat          Float
  fiber        Float?
  sugar        Float?
  saturatedFat Float?
  sodium       Float?

  @@unique([source, externalId])
}
